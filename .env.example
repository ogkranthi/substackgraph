# Copy to .env and fill in. Used by docker-compose.yml.

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → token).
# Leave blank to run the app locally on http://localhost:8000 without the tunnel.
TUNNEL_TOKEN=

# Seed publication shown on the landing page.
SUBSTACKGRAPH_SEED=https://theairuntime.substack.com

# Load the bundled demo neighborhood on first boot so the site shows something immediately.
# Set to 0 once you have crawled real data into the /data volume.
LOAD_DEMO_ON_START=1

# Allow on-demand crawling via POST /crawl. Keep 0 for a public URL (ToS exposure).
ALLOW_LIVE_CRAWL=0
